  "operatorSubset": {
    "operatorSetId": "alphapilot_factor_operator_subset_v01",
    "purpose": "Keep first factor research iteration explainable, auditable, and lightweight.",
    "timeSeriesOperators": [
      {
        "operatorId": "ts_mean",
        "category": "time_series",
        "description": "Rolling mean over a lookback window."
      },
      {
        "operatorId": "ts_std",
        "category": "time_series",
        "description": "Rolling standard deviation over a lookback window."
      },
      {
        "operatorId": "ts_rank",
        "category": "time_series",
        "description": "Rank latest value within a rolling window."
      },
      {
        "operatorId": "ts_zscore",
        "category": "time_series",
        "description": "Rolling z-score of latest value."
      },
      {
        "operatorId": "ts_delta",
        "category": "time_series",
        "description": "Difference from N bars ago."
      },
      {
        "operatorId": "ts_return",
        "category": "time_series",
        "description": "Return over N bars."
      },
      {
        "operatorId": "ts_ema",
        "category": "time_series",
        "description": "Exponential moving average."
      },
      {
        "operatorId": "ts_corr",
        "category": "time_series",
        "description": "Rolling correlation between two fields."
      },
      {
        "operatorId": "ts_min",
        "category": "time_series",
        "description": "Rolling minimum."
      },
      {
        "operatorId": "ts_max",
        "category": "time_series",
        "description": "Rolling maximum."
      }
    ],
    "crossSectionalOperators": [
      {
        "operatorId": "rank",
        "category": "cross_sectional",
        "description": "Cross-sectional rank at one timestamp."
      },
      {
        "operatorId": "zscore",
        "category": "cross_sectional",
        "description": "Cross-sectional z-score at one timestamp."
      },
      {
        "operatorId": "winsorize",
        "category": "cross_sectional",
        "description": "Clip extreme cross-sectional values."
      },
      {
        "operatorId": "scale",
        "category": "cross_sectional",
        "description": "Scale values to comparable magnitude."
      },
      {
        "operatorId": "demean",
        "category": "cross_sectional",
        "description": "Remove cross-sectional mean."
      }
    ],
    "combinationOperators": [
      {
        "operatorId": "add",
        "category": "combination",
        "description": "Add two factor expressions."
      },
      {
        "operatorId": "sub",
        "category": "combination",
        "description": "Subtract one factor expression from another."
      },
      {
        "operatorId": "mul",
        "category": "combination",
        "description": "Multiply factor expressions."
      },
      {
        "operatorId": "div_safe",
        "category": "combination",
        "description": "Safe division with zero guard."
      },
      {
        "operatorId": "where",
        "category": "combination",
        "description": "Conditional selection."
      },
      {
        "operatorId": "clip",
        "category": "combination",
        "description": "Clip values to a bounded range."
      }
    ],
    "excludedOperatorFamilies": [
      "genetic_programming",
      "automatic_complex_expression_generation",
      "deep_learning_factors",
      "reinforcement_learning_factors"
    ],
    "researchOnly": true,
    "implementationStatus": "design_only"
  },
  "manualFactorLibrary": [
    {
      "factorId": "momentum_3",
      "name": "Momentum 3",
      "description": "Short horizon momentum over three bars.",
      "formula": "ts_return(close, 3)",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "higher_may_be_stronger",
      "applicableRegime": [
        "trend",
        "breakout"
      ],
      "riskNotes": [
        "Can overfit during choppy regimes."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "momentum_12",
      "name": "Momentum 12",
      "description": "Medium horizon momentum over twelve bars.",
      "formula": "ts_return(close, 12)",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "higher_may_be_stronger",
      "applicableRegime": [
        "trend"
      ],
      "riskNotes": [
        "May lag fast reversals."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "reversal_3",
      "name": "Reversal 3",
      "description": "Short horizon reversal pressure.",
      "formula": "-ts_return(close, 3)",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "higher_may_indicate_rebound",
      "applicableRegime": [
        "mean_reversion"
      ],
      "riskNotes": [
        "Can fight strong trends."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "volume_expansion_24h",
      "name": "Volume Expansion 24H",
      "description": "Volume expansion versus recent average.",
      "formula": "volume / ts_mean(volume, 24)",
      "requiredFields": [
        "volume"
      ],
      "expectedDirection": "higher_indicates_attention",
      "applicableRegime": [
        "breakout",
        "trend"
      ],
      "riskNotes": [
        "Volume spikes can be exhaustion rather than continuation."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "volume_expansion_3d",
      "name": "Volume Expansion 3D",
      "description": "Three-day style volume expansion on 1h bars.",
      "formula": "ts_mean(volume, 24) / ts_mean(volume, 72)",
      "requiredFields": [
        "volume"
      ],
      "expectedDirection": "higher_indicates_attention",
      "applicableRegime": [
        "breakout",
        "trend"
      ],
      "riskNotes": [
        "Requires enough history for stable comparison."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "distance_to_ema20",
      "name": "Distance To Ema20",
      "description": "Distance from close to EMA20.",
      "formula": "(close - ts_ema(close, 20)) / ts_ema(close, 20)",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "context_dependent",
      "applicableRegime": [
        "trend",
        "mean_reversion"
      ],
      "riskNotes": [
        "Large distance can mean strength or overextension."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "distance_to_ema50",
      "name": "Distance To Ema50",
      "description": "Distance from close to EMA50.",
      "formula": "(close - ts_ema(close, 50)) / ts_ema(close, 50)",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "context_dependent",
      "applicableRegime": [
        "trend",
        "mean_reversion"
      ],
      "riskNotes": [
        "Slower signal can lag new regimes."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "bollinger_position",
      "name": "Bollinger Position",
      "description": "Position inside a Bollinger-style range.",
      "formula": "(close - lower_band) / (upper_band - lower_band)",
      "requiredFields": [
        "close",
        "upper_band",
        "lower_band"
      ],
      "expectedDirection": "context_dependent",
      "applicableRegime": [
        "mean_reversion",
        "breakout"
      ],
      "riskNotes": [
        "Band position needs volatility context."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "volatility_24h",
      "name": "Volatility 24H",
      "description": "Short-term realized volatility.",
      "formula": "ts_std(returns_1, 24)",
      "requiredFields": [
        "returns_1"
      ],
      "expectedDirection": "lower_or_moderate_preferred",
      "applicableRegime": [
        "trend",
        "mean_reversion",
        "avoid"
      ],
      "riskNotes": [
        "Very low volatility can imply no opportunity."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "volatility_3d",
      "name": "Volatility 3D",
      "description": "Three-day realized volatility on 1h bars.",
      "formula": "ts_std(returns_1, 72)",
      "requiredFields": [
        "returns_1"
      ],
      "expectedDirection": "context_dependent",
      "applicableRegime": [
        "trend",
        "breakout",
        "avoid"
      ],
      "riskNotes": [
        "High volatility can improve movement but harm execution."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "relative_strength_vs_btc",
      "name": "Relative Strength Vs Btc",
      "description": "Pair return relative to BTC.",
      "formula": "ts_return(close, 12) - btcReturn_12",
      "requiredFields": [
        "close",
        "btcReturn"
      ],
      "expectedDirection": "higher_may_be_stronger",
      "applicableRegime": [
        "trend"
      ],
      "riskNotes": [
        "BTC proxy must be time-aligned."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "liquidity_rank",
      "name": "Liquidity Rank",
      "description": "Cross-sectional liquidity rank.",
      "formula": "rank(quoteVolume)",
      "requiredFields": [
        "quoteVolume"
      ],
      "expectedDirection": "higher_preferred",
      "applicableRegime": [
        "all"
      ],
      "riskNotes": [
        "Liquidity is a research filter, not alpha by itself."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "atr_pct",
      "name": "Atr Pct",
      "description": "ATR as a percentage of close.",
      "formula": "atr / close",
      "requiredFields": [
        "atr",
        "close"
      ],
      "expectedDirection": "context_dependent",
      "applicableRegime": [
        "trend",
        "mean_reversion",
        "avoid"
      ],
      "riskNotes": [
        "Requires consistent ATR calculation."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "trend_strength",
      "name": "Trend Strength",
      "description": "EMA trend structure strength.",
      "formula": "(ts_ema(close, 20) - ts_ema(close, 50)) / close",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "higher_may_be_stronger",
      "applicableRegime": [
        "trend"
      ],
      "riskNotes": [
        "Can fail during late trend exhaustion."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "mean_reversion_distance",
      "name": "Mean Reversion Distance",
      "description": "Distance from mean for rebound research.",
      "formula": "-abs((close - ts_mean(close, 24)) / ts_std(close, 24))",
      "requiredFields": [
        "close"
      ],
      "expectedDirection": "higher_means_less_extreme",
      "applicableRegime": [
        "mean_reversion"
      ],
      "riskNotes": [
        "Extreme distance needs separate direction logic."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    },
    {
      "factorId": "breakout_pressure",
      "name": "Breakout Pressure",
      "description": "Pressure near recent highs with volume.",
      "formula": "rank(close / ts_max(high, 24)) + rank(volume / ts_mean(volume, 24))",
      "requiredFields": [
        "close",
        "high",
        "volume"
      ],
      "expectedDirection": "higher_may_indicate_breakout_pressure",
      "applicableRegime": [
        "breakout"
      ],
      "riskNotes": [
        "Breakout pressure needs false-breakout control."
      ],
      "source": "alphapilot_manual_factor_library_v01",
      "researchOnly": true
    }
  ],
